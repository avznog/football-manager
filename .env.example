# Copy to .env.local and adjust.

# Local development uses a Homebrew Postgres (see README).
# In production this is a Neon pooled connection string.
DATABASE_URL="postgres://football:football@127.0.0.1:5432/football_manager"

# Used by `npm run test:db` only.
TEST_DATABASE_URL="postgres://football:football@127.0.0.1:5432/football_manager_test"

# The first super admin, created by `npm run db:seed` if absent.
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-me"
