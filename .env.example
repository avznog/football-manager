# Copy to .env.local and adjust.

# Local development uses a Homebrew Postgres (see README).
# In production this is a Neon pooled connection string.
DATABASE_URL="postgres://football:football@127.0.0.1:5432/football_manager"

# Used by `npm run test:db` only.
TEST_DATABASE_URL="postgres://football:football@127.0.0.1:5432/football_manager_test"

# The shared secret of the iPhone trace sink (`/api/dev/trace`, scripts/iphone-trace/README.md).
# Preview only: the owner sets it in Vercel's *preview* environment by hand, and never in production
# — the sink is off there whatever this says. Never committed; this file carries no value for it.
# Leaving it unset **disables the sink**: the route then answers 404 to everything, which is the
# intended failure mode for a deployment nobody configured.
TRACE_SECRET=""

# The first super admin, created by `npm run db:seed` if absent.
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-me"
